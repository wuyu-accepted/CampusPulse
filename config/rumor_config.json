{
    "simulator": {
        "environment": {
            "name": "rumor_spiral_governance",
            "mode": "round",
            "max_steps": 8,
            "interval": 60.0,
            "bus_idle_timeout": 60.0,
            "export_training_data": true,
            "export_event_data": true,
            "collection_interval": 30,
            "additional_config": {
                "export_event_flow": false
            }
        }
    },
    "agent": {
        "profile": {
            "OrdinaryUser": {
                "count": 20,
                "profile_path": "OrdinaryUser.json",
                "schema_path": "OrdinaryUser.json"
            },
            "OpinionLeader": {
                "count": 4,
                "profile_path": "OpinionLeader.json",
                "schema_path": "OpinionLeader.json"
            },
            "MediaOrganization": {
                "count": 2,
                "profile_path": "MediaOrganization.json",
                "schema_path": "MediaOrganization.json"
            },
            "FactCheckOrganization": {
                "count": 1,
                "profile_path": "FactCheckOrganization.json",
                "schema_path": "FactCheckOrganization.json"
            }
        },
        "planning": "COTPlanning",
        "memory": {
            "strategy": "ShortLongStrategy",
            "storages": {
                "short_term_storage": {
                    "class": "ListMemoryStorage",
                    "capacity": 100
                },
                "long_term_storage": {
                    "class": "VectorMemoryStorage",
                    "capacity": 100,
                    "model_config_name": "vllm-embedding-bert"
                }
            },
            "metric_weights": {
                "recency": 0.7
            },
            "transfer_conditions": {},
            "operations": {
                "add": {
                    "class": "AddMemoryOperation"
                },
                "retrieve": {
                    "class": "RetrieveMemoryOperation"
                },
                "remove": {
                    "class": "RemoveMemoryOperation"
                }
            },
            "metrics": {
                "recency": {
                    "class": "RecencyMetric",
                    "weight": 0.5
                },
                "relevance": {
                    "class": "RelevanceMetric",
                    "model_config_name": "vllm-embedding-bert",
                    "weight": 0.5
                }
            }
        }
    },
    "database": {
        "enabled": false,
        "host": "localhost",
        "port": 5432,
        "dbname": "onesim",
        "user": "postgres",
        "password": "CHANGE_ME"
    },
    "distribution": {
        "enabled": false,
        "mode": "single",
        "node_id": "1",
        "master_address": "localhost",
        "master_port": 10051
    },
    "monitor": {
        "enabled": false,
        "update_interval": 30
    }
}
