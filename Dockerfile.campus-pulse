# Security-focused internal image for the CampusPulse workbench.
# It intentionally excludes the upstream OneSim backend and its generic
# pipeline, filesystem, model-configuration and simulation endpoints.

FROM node:22-slim AS frontend-builder

WORKDIR /frontend
COPY src/frontend/package.json src/frontend/package-lock.json ./
RUN npm ci
COPY src/frontend/ ./
RUN test -f index.html \
    && test -f src/main.js \
    && npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    PORT=8000 \
    CAMPUS_PULSE_BIND_HOST=127.0.0.1 \
    CAMPUS_PULSE_WORKBENCH_DB=/var/lib/campus-pulse/workbench.sqlite3 \
    CAMPUS_PULSE_RUNTIME_ADAPTER=disabled \
    CAMPUS_PULSE_LIVE_LLM_ENABLED=false \
    CAMPUS_PULSE_MASS_SIM_RELEASE_DIR=/app/_run/governance-arena-v2-release \
    CAMPUS_PULSE_GOVERNANCE_V2_RELEASE_MANIFEST=/app/_run/governance-arena-v2-release/governance-v2-model-release.json \
    CAMPUS_PULSE_RUNTIME_CONCURRENCY_CAP=32 \
    CAMPUS_PULSE_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl nginx supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system campuspulse \
    && useradd --system --gid campuspulse --home /nonexistent \
        --shell /usr/sbin/nologin campuspulse

WORKDIR /app
COPY requirements-campus-pulse-online.lock ./
RUN pip install --no-cache-dir --requirement requirements-campus-pulse-online.lock

RUN mkdir -p \
        /app/src/backend/campus_pulse \
        /app/src/backend/routers \
        /app/scripts/campus_pulse \
        /var/lib/campus-pulse \
        /var/log/supervisor \
    && chown -R campuspulse:campuspulse /var/lib/campus-pulse

COPY src/backend/__init__.py /app/src/backend/__init__.py
COPY src/backend/campus_pulse_app.py /app/src/backend/campus_pulse_app.py
COPY src/backend/campus_pulse/ /app/src/backend/campus_pulse/
COPY src/backend/routers/__init__.py /app/src/backend/routers/__init__.py
COPY src/backend/routers/campus_pulse.py /app/src/backend/routers/campus_pulse.py
COPY src/envs/campus_pulse_governance/__init__.py \
    /app/src/envs/campus_pulse_governance/__init__.py
COPY src/envs/campus_pulse_governance/governance_arena_v2.py \
    src/envs/campus_pulse_governance/llm_agents.py \
    src/envs/campus_pulse_governance/mass_population.py \
    src/envs/campus_pulse_governance/mass_simulation.py \
    src/envs/campus_pulse_governance/policies.py \
    src/envs/campus_pulse_governance/shock_replay.py \
    src/envs/campus_pulse_governance/calibration.py \
    src/envs/campus_pulse_governance/semantic_population.py \
    /app/src/envs/campus_pulse_governance/
COPY _run/governance-arena-v2-release/ \
    /app/_run/governance-arena-v2-release/
COPY scripts/campus_pulse/run_runtime_worker.py \
    /app/scripts/campus_pulse/run_runtime_worker.py
COPY scripts/campus_pulse/manage_live_runtime.py \
    /app/scripts/campus_pulse/manage_live_runtime.py

COPY --from=frontend-builder /frontend/dist /var/www/html
COPY docker/campus-pulse-nginx.conf /etc/nginx/nginx.conf
COPY docker/campus-pulse-supervisord.conf \
    /etc/supervisor/conf.d/campus-pulse.conf

EXPOSE 80
VOLUME ["/var/lib/campus-pulse"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl --fail --silent --show-error \
        http://127.0.0.1/ready >/dev/null || exit 1

CMD ["/usr/bin/supervisord", "-c", \
     "/etc/supervisor/conf.d/campus-pulse.conf"]
