    "faq_effectiveness": {"value": {"academic_information": 0.50, "emotional_support": 0.05, "safety_report": 0.12, "campus_service": 0.52}, "source_type": "assumption", "evidence": "FAQ和自助流程效果待工单日志校准。"},
