    "shock_curve": {"value": [0.55, 0.65, 0.8, 1.0, 1.35, 1.8, 2.2, 2.0, 1.65, 1.25, 0.9, 0.7], "source_type": "assumption", "evidence": "后勤故障和集中投诉的合成冲击轮廓。"},
    "need_mix": {"value": {"academic_information": 0.15, "emotional_support": 0.08, "safety_report": 0.02, "campus_service": 0.75}, "source_type": "operator_input", "evidence": "后勤场景功能性诉求组合。"},
    "urgency_mix": {"value": {"low": 0.40, "medium": 0.42, "high": 0.16, "critical": 0.02}, "source_type": "assumption", "evidence": "缺少真实工单优先级，作为压力测试输入。"},
    "natural_response_probability": {"value": {"academic_information": 0.6173, "emotional_support": 0.8172, "safety_report": 0.7284, "campus_service": 0.7303}, "source_type": "empirical_proxy", "evidence": "稳定采集制度内训练窗（2026-05-01至2026-06-15）关键词代理类别的最终非零评论比例；留出窗从2026-06-16开始。", "limitations": "社区回应不等于工单完成；关键词类别未经人工金标准验证。"},
