    "dynamic_backlog_threshold": {"value": 10, "source_type": "operator_input", "evidence": "后勤队列触发扩容阈值。"},
    "dynamic_capacity_increment": {"value": 5, "source_type": "operator_input", "evidence": "后勤临时扩容工作单元。"},
