{
  "scenario_id": "course_selection",
  "version": "1.2.0",
  "title": "选课期信息需求冲击",
  "description": "模拟选课和课程评价集中出现时，FAQ、同伴经验与教务服务之间的分流。",
  "parameters": {
    "rounds": {"value": 48, "source_type": "operator_input", "evidence": "MVP演示采用48个合成决策轮次。", "limitations": "轮次不对应真实小时。"},
    "base_arrival_rate": {"value": 6.0, "source_type": "operator_input", "evidence": "MVP归一化负荷规模；历史事件仅用于独立的留一事件形状回测，不用于写入此值。", "limitations": "合成轮次没有现实时间映射，不是现实到达率或绝对工作量预测。"},
    "shock_curve": {"value": [0.35, 0.45, 0.65, 1.05, 1.65, 2.4, 2.8, 2.4, 1.8, 1.3, 0.9, 0.55], "source_type": "assumption", "evidence": "选课窗口开启后的合成信息需求冲击。"},
    "need_mix": {"value": {"academic_information": 0.75, "emotional_support": 0.10, "safety_report": 0.02, "campus_service": 0.13}, "source_type": "operator_input", "evidence": "选课期功能性诉求组合。"},
    "urgency_mix": {"value": {"low": 0.38, "medium": 0.44, "high": 0.16, "critical": 0.02}, "source_type": "assumption", "evidence": "缺少人工紧急度标注，作为压力测试输入。"},
    "natural_response_probability": {"value": {"academic_information": 0.6173, "emotional_support": 0.8172, "safety_report": 0.7284, "campus_service": 0.7303}, "source_type": "empirical_proxy", "evidence": "稳定采集制度内训练窗（2026-05-01至2026-06-15）关键词代理类别的最终非零评论比例；留出窗从2026-06-16开始。", "limitations": "累计回应不等于正确信息；关键词类别未经人工金标准验证。"},
    "mean_replies_if_responded": {"value": {"academic_information": 4.20, "emotional_support": 6.93, "safety_report": 7.94, "campus_service": 4.20}, "source_type": "derived", "evidence": "稳定采集制度内训练窗各关键词代理类别的有评论帖子条件均值。", "limitations": "长尾形状另由假设的离散参数控制。"},
    "reply_dispersion": {"value": 1.5, "source_type": "assumption", "evidence": "Gamma-Poisson过度离散参数。"},
    "natural_resolution_probability": {"value": {"academic_information": 0.32, "emotional_support": 0.18, "safety_report": 0.10, "campus_service": 0.25}, "source_type": "assumption", "evidence": "数据无实际解决状态，作为敏感性输入。"},
    "work_units_by_urgency": {"value": {"low": 1, "medium": 1, "high": 2, "critical": 3}, "source_type": "operator_input", "evidence": "服务工作量抽象。"},
    "routing": {"value": {"academic_information": "academic_services", "emotional_support": "student_support", "safety_report": "campus_security", "campus_service": "facilities"}, "source_type": "derived", "evidence": "按治理职能建立的部门映射。"},
    "department_capacity": {"value": {"academic_services": 9, "student_support": 2, "campus_security": 1, "facilities": 3}, "source_type": "operator_input", "evidence": "选课期MVP容量假设。"},
    "faq_eligible_need_types": {"value": ["academic_information", "campus_service"], "source_type": "derived", "evidence": "信息与流程类诉求适合标准答案。"},
    "faq_effectiveness": {"value": {"academic_information": 0.62, "emotional_support": 0.05, "safety_report": 0.15, "campus_service": 0.48}, "source_type": "assumption", "evidence": "FAQ干预效果待真实官方回应数据校准。"},
    "peer_boost_capacity": {"value": 10, "source_type": "operator_input", "evidence": "每轮课程经验同伴回应名额。"},
    "peer_boost_success": {"value": {"academic_information": 0.40, "emotional_support": 0.45, "safety_report": 0.15, "campus_service": 0.30}, "source_type": "assumption", "evidence": "同伴经验完成运营响应路径的概率假设。"},
    "dynamic_backlog_threshold": {"value": 10, "source_type": "operator_input", "evidence": "教务队列触发扩容阈值。"},
    "dynamic_capacity_increment": {"value": 4, "source_type": "operator_input", "evidence": "临时扩容工作单元。"},
    "dynamic_capacity_limit": {"value": 4, "source_type": "operator_input", "evidence": "临时扩容上限。"},
    "cost_weights": {"value": {"faq_reach": 0.15, "peer_action": 0.6, "service_work_unit": 1.0, "dynamic_capacity_unit": 1.7, "routing_action": 0.1}, "source_type": "operator_input", "evidence": "无量纲治理成本权重。"}
  },
  "limitations": ["自然评论可能含错误建议；v1只模拟回应路径，不判断课程建议真伪。"]
}
